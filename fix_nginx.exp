#!/usr/bin/expect -f
set timeout 10
set host "192.168.18.233"
set user "root"
set pass "siitk"

spawn ssh -o StrictHostKeyChecking=no $user@$host "systemctl stop nginx && systemctl disable nginx && /etc/init.d/nginx restart"
expect {
    "*assword:*" {
        send "$pass\r"
        exp_continue
    }
    eof
}
