#!/usr/bin/expect -f
set timeout 10
set host "192.168.18.233"
set user "root"
set pass "siitk"

spawn ssh -o StrictHostKeyChecking=no $user@$host "find /www/wwwroot/hosting -type d -name '.git' -execdir git config --get remote.origin.url \\; 2>/dev/null"
expect {
    "*assword:*" {
        send "$pass\r"
        exp_continue
    }
    eof
}
