# Salin berkas ini menjadi .env, lalu sesuaikan nilainya.
#
#   cp .env.example .env
#
# Berkas .env sendiri tidak ikut ke repositori, jadi setiap kali proyek ini
# di-clone ke tempat baru, langkah penyalinan ini wajib dikerjakan lebih dulu.

# Basis data. SQLite, berkasnya dibuat otomatis oleh `npx prisma db push`.
DATABASE_URL="file:./dev.db"

# Kunci penanda tangan JWT. WAJIB diganti sebelum dipakai di luar mesin
# sendiri: token yang ditandatangani kunci contoh ini bisa dipalsukan siapa pun
# yang pernah membaca berkas ini.
JWT_SECRET="ganti-dengan-string-acak-panjang-untuk-produksi"

# Porta backend Express. Frontend menghubunginya lewat NEXT_PUBLIC_API_URL yang
# bawaannya http://localhost:4000, jadi ubah keduanya kalau porta ini diganti.
PORT=4000

# CATATAN, variabel NEXT_PUBLIC_* TIDAK dibaca dari berkas ini.
# Next.js hanya membaca berkas env di dalam direktori webapp/, jadi setelan
# frontend harus ditulis di webapp/.env.local, bukan di sini:
#
#   NEXT_PUBLIC_API_URL="http://localhost:4000"
#   NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"
#
# Keduanya punya nilai bawaan di dalam kode, jadi keduanya boleh tidak diisi
# sama sekali. Yang kedua mengatur panel akun demo di halaman masuk: bawaannya
# menyala supaya proyek yang baru di-clone langsung bisa dicoba, dan WAJIB
# dimatikan sebelum dipasang di tempat yang bisa dijangkau publik, sebab panel
# itu menampilkan email dan kata sandi apa adanya di halaman terbuka.

# ── Opsional ─────────────────────────────────────────────────────────────────
# Keduanya boleh dibiarkan kosong. Aplikasi tetap berjalan penuh tanpa ini;
# yang nonaktif hanya obrolan NeuroBot dan terjemahan otomatis isi dinamis.
GEMINI_API_KEY=""
DEEPL_API_KEY=""
