#!/usr/bin/expect -f
set timeout 10
set host "192.168.18.233"
set user "root"
set pass "siitk"

spawn ssh -o StrictHostKeyChecking=no $user@$host "rm -rf /www/wwwroot/hosting && git clone https://github.com/akhzaozy/neuronmotion /www/wwwroot/hosting
expect {
    "*assword:*" {
        send "$pass\r"
        exp_continue
    }
    eof
}
