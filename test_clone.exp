#!/usr/bin/expect -f
set timeout 10
set host "192.168.18.233"
set user "root"
set pass "siitk"

spawn ssh -o StrictHostKeyChecking=no $user@$host "git clone https://github.com/akhzaozy/neuronmotion /tmp/test_clone"
expect {
    "*assword:*" {
        send "$pass\r"
        exp_continue
    }
    eof
}
