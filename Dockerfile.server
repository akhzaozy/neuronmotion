# ==============================================================================
# NeuronMotion - Backend REST API & ML Processing Engine
# ==============================================================================
FROM node:20-alpine AS runner

WORKDIR /app

# Memasang pustaka yang dibutuhkan Prisma engine dan dumb-init untuk signal handler
RUN apk add --no-cache openssl libc6-compat dumb-init

# Salin berkas definisi dependensi dan skema database
COPY package.json package-lock.json* ./
COPY prisma ./prisma

# Pasang dependensi produksi dan bangkitkan Prisma Client untuk arsitektur container
RUN (npm ci --omit=dev || npm install --omit=dev) && npx prisma generate

# Salin kode sumber backend dan skrip operasional
COPY server ./server
COPY scripts ./scripts

# Pastikan script entrypoint dapat dieksekusi
RUN chmod +x scripts/docker-entrypoint.sh

# Konfigurasi variabel lingkungan bawaan
ENV NODE_ENV=production \
    PORT=4000 \
    DATABASE_URL="file:/app/prisma/dev.db"

EXPOSE 4000

# Dumb-init menangani sinyal PID 1 (SIGTERM, SIGINT) dengan aman
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/bin/sh", "/app/scripts/docker-entrypoint.sh"]
CMD ["node", "server/index.js"]
